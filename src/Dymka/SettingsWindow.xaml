<Window x:Class="Dymka.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dymka"
        Title="Настройки - Дымка" Width="640" Height="760" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource Ground}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="20,16"/>
      <Setter Property="Margin" Value="0,0,0,14"/>
    </Style>
    <Style x:Key="CardTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource LineStrong}"
                    Background="{DynamicResource Surface}" Padding="14,6">
              <ContentPresenter TextElement.FontSize="13"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="20,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Отмена" Style="{StaticResource SecondaryButton}" MinWidth="100" IsCancel="True"/>
        <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="120" Margin="8,0,0,0"
                IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </Border>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,20,20,6">
      <StackPanel>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Вид" Style="{StaticResource CardTitle}"/>
            <UniformGrid Columns="2">
              <RadioButton x:Name="LayoutTop" GroupName="layout" Style="{StaticResource ChoiceRadio}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Data="{StaticResource IcLayoutTop}" Size="22" Foreground="{DynamicResource Ink2}" Margin="0,0,10,0"/>
                  <StackPanel>
                    <TextBlock Text="Вкладки сверху" FontWeight="SemiBold"/>
                    <TextBlock Text="Как в Chrome" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </StackPanel>
              </RadioButton>
              <RadioButton x:Name="LayoutSide" GroupName="layout" Style="{StaticResource ChoiceRadio}" Margin="6,0,0,0">
                <StackPanel Orientation="Horizontal">
                  <local:Glyph Data="{StaticResource IcLayoutSide}" Size="22" Foreground="{DynamicResource Ink2}" Margin="0,0,10,0"/>
                  <StackPanel>
                    <TextBlock Text="Вкладки сбоку" FontWeight="SemiBold"/>
                    <TextBlock Text="Длинные названия целиком" Style="{StaticResource Hint}"/>
                  </StackPanel>
                </StackPanel>
              </RadioButton>
            </UniformGrid>
            <TextBlock Text="Переключить вид можно и в меню «⋯» - «Вкладки сбоку / сверху»." Style="{StaticResource Hint}" Margin="0,10,0,0"/>
            <TextBlock Text="Оформление" FontWeight="SemiBold" Margin="0,16,0,8"/>
            <WrapPanel x:Name="ThemePanel"/>
            <TextBlock Text="«Как в Windows» - светлое или тёмное, как выбрано в параметрах Windows. Сайты, которые умеют, тоже переключаются на тёмную тему."
                       Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="При запуске" Style="{StaticResource CardTitle}"/>
            <WrapPanel>
              <RadioButton x:Name="StartRestore" GroupName="startup" Style="{StaticResource Chip}" Content="Восстанавливать вкладки"/>
              <RadioButton x:Name="StartNew" GroupName="startup" Style="{StaticResource Chip}" Content="Начинать с новой вкладки"/>
            </WrapPanel>
            <TextBlock Text="Вкладки прошлого сеанса появляются спящими и загружаются по щелчку - память не тратится. Вход на сайты (cookie) при закрытии всё равно удаляется, если это включено ниже."
                       Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Поиск" Style="{StaticResource CardTitle}"/>
            <WrapPanel x:Name="EnginePanel"/>
            <TextBlock Text="DuckDuckGo и Startpage не собирают историю поиска." Style="{StaticResource Hint}"/>
            <DockPanel Margin="0,14,0,0">
              <CheckBox x:Name="SuggestBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Подсказки поисковой системы при вводе"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="То, что вы набираете в адресной строке, отправляется выбранной поисковой системе, и она предлагает варианты. Подсказки «перейти на сайт» (ваши плитки, вкладки, сайты с сохранёнными паролями, известные официальные сайты) работают и без этого - на компьютере."/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Экономия памяти" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Усыплять вкладку, если она не открывалась:" Margin="0,0,0,8"/>
            <WrapPanel x:Name="SleepPanel"/>
            <TextBlock Text="Спящая вкладка не занимает память и загружается заново, когда вы к ней возвращаетесь. Вкладки, где играет звук, не засыпают."
                       Style="{StaticResource Hint}"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Конфиденциальность" Style="{StaticResource CardTitle}"/>

            <DockPanel Margin="0,0,0,12">
              <CheckBox x:Name="ClearOnExit" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Удалять cookie и данные сайтов при закрытии"/>
                <TextBlock Text="Кроме cookie сайтов из белого списка ниже." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>

            <DockPanel Margin="0,0,0,12">
              <CheckBox x:Name="Block3p" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Блокировать сторонние cookie"/>
                <TextBlock Text="Изменение вступит в силу после перезапуска браузера." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>

            <StackPanel Margin="0,0,0,12">
              <TextBlock Text="Проверка сайтов и загрузок (SmartScreen)"/>
              <TextBlock Text="Предупреждает о мошеннических сайтах и опасных файлах, но для этого отправляет адреса страниц в Microsoft."
                         Style="{StaticResource Hint}"/>
              <WrapPanel x:Name="SmartScreenPanel" Margin="0,8,0,0"/>
            </StackPanel>

            <DockPanel Margin="0,0,0,4">
              <CheckBox x:Name="AutoLists" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Обновлять списки блокировки раз в неделю"/>
                <TextBlock x:Name="ListsInfo" Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
            <Button Content="Обновить списки сейчас" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Margin="0,8,0,0" Click="UpdateLists_Click" x:Name="UpdateListsBtn"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Российские сертификаты (Минцифры)" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="RuCaBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Открывать сайты с сертификатами Минцифры"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Сертификаты встроены в браузер, в Windows ничего не устанавливается. Действуют только для сайтов в зонах .ru, .рф, .su, .рус и сайтов из списка ниже - на остальных сайтах им не доверяется."/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="Другие сайты с сертификатами Минцифры (по одному в строке):" Style="{StaticResource Hint}" Margin="0,12,0,6"/>
            <TextBox x:Name="RuCaSites" Style="{StaticResource FieldBox}" AcceptsReturn="True" Height="70" TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Белый список cookie" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Сайты, на которых вход сохраняется после закрытия браузера. По одному в строке." Style="{StaticResource Hint}" Margin="0,-6,0,8"/>
            <TextBox x:Name="Whitelist" Style="{StaticResource FieldBox}" AcceptsReturn="True" Height="110"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Сайты без блокировки" Style="{StaticResource CardTitle}"/>
            <TextBlock Text="Если сайт работает неправильно, блокировку на нём можно выключить. По одному в строке." Style="{StaticResource Hint}" Margin="0,-6,0,8"/>
            <TextBox x:Name="Exceptions" Style="{StaticResource FieldBox}" AcceptsReturn="True" Height="90"
                     TextWrapping="NoWrap" VerticalContentAlignment="Top"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Фон новой вкладки" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <Border DockPanel.Dock="Left" Width="128" Height="72" CornerRadius="10" Background="{DynamicResource Field}" ClipToBounds="True"
                      BorderBrush="{DynamicResource Line}" BorderThickness="1" Margin="0,0,16,0">
                <Grid>
                  <TextBlock x:Name="WallpaperNone" Text="Без фона" HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource Muted}" FontSize="12"/>
                  <Image x:Name="WallpaperPreview" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Grid>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,8"
                           Text="Свой фон - картинка JPG, PNG или WebP, лучше светлая 16:9 (например, 2560×1440). Переключать фоны, включать часы и смену фона каждый день удобнее на самой новой вкладке: кнопка с шестерёнкой внизу справа."/>
                <StackPanel Orientation="Horizontal">
                  <Button Content="Свой фон…" Style="{StaticResource SecondaryButton}" Click="WallpaperPick_Click" Padding="14,0"/>
                  <Button x:Name="WallpaperRemoveBtn" Content="Без фона" Style="{StaticResource SecondaryButton}" Click="WallpaperRemove_Click" Margin="8,0,0,0" Padding="14,0"/>
                </StackPanel>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Скачивание" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="AskDownloadBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Спрашивать, куда сохранить каждый файл"/>
                <TextBlock Text="При скачивании откроется окно «Сохранить как» с выбором папки и имени файла." Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="Папка для загрузок" Margin="0,14,0,6"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="По умолчанию" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0"
                      Click="DownloadFolderReset_Click" x:Name="DownloadFolderResetBtn"/>
              <Button DockPanel.Dock="Right" Content="Изменить…" Style="{StaticResource SecondaryButton}" Padding="14,0" Margin="8,0,0,0"
                      Click="DownloadFolder_Click"/>
              <Border Background="{DynamicResource Field}" CornerRadius="10" Padding="12,0" Height="38">
                <TextBlock x:Name="DownloadFolderText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              </Border>
            </DockPanel>
            <TextBlock Text="Сюда файлы сохраняются, если не спрашивать; при вопросе окно откроется в последней выбранной папке." Style="{StaticResource Hint}" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Мини-плеер для музыки" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="MiniPlayerBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Показывать мини-плеер, когда музыка играет на другой вкладке"/>
                <TextBlock Text="Его можно перетащить мышью; у края страницы он прилипает, а у левого и правого края становится вертикальным. Двойной щелчок по плееру возвращает его в угол."
                           Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
            <TextBlock Text="Оформление мини-плеера" Margin="0,14,0,8"/>
            <WrapPanel x:Name="MiniStylePanel"/>
          </StackPanel>
        </Border>

        <Border x:Name="VideoCard" Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Видео" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="AutoPipBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Мини-окно с видео при переходе на другую вкладку"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="Если на вкладке идёт видео со звуком, при переходе на другую вкладку оно продолжится в маленьком окне поверх всех окон. Окно можно перетаскивать и менять его размер. Вернётесь на вкладку - видео вернётся на страницу."/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Перевод страниц" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="OfferTranslationBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Предлагать перевод страниц не на русском"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="В адресной строке появится кнопка «Перевести». Перевод делает Яндекс Переводчик: текст страницы отправляется на его серверы - только когда вы нажали «Перевести». Перевести можно и выделенный текст: правая кнопка мыши - «Перевести»."/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Перевод видео" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="VideoTranslationBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Закадровый перевод и субтитры на русском"/>
                <TextBlock Style="{StaticResource Hint}"
                           Text="На YouTube, VK Видео, Rutube, Vimeo и других сайтах на видео появится кнопка «Перевести». Перевод делает сервис Яндекса (открытый проект voice-over-translation): адрес видео отправляется на его серверы."/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Обновления" Style="{StaticResource CardTitle}"/>
            <DockPanel>
              <CheckBox x:Name="CheckUpdatesBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center"/>
              <StackPanel Margin="0,0,16,0">
                <TextBlock Text="Проверять обновления при запуске"/>
                <TextBlock x:Name="VersionInfo" Style="{StaticResource Hint}"/>
              </StackPanel>
            </DockPanel>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
          <StackPanel>
            <TextBlock Text="Разрешения сайтов" Style="{StaticResource CardTitle}"/>
            <TextBlock x:Name="PermInfo" Style="{StaticResource Hint}" Margin="0,-6,0,8"/>
            <Button Content="Сбросить все разрешения" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left"
                    Click="ResetPermissions_Click" x:Name="ResetPermBtn"/>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
