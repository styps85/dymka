<Window x:Class="Dymka.TabSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dymka"
        Title="Поиск по вкладкам" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight" ShowInTaskbar="False" ShowActivated="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource Ink}" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="PopupCard" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="{DynamicResource PopupLine}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.14" Color="#1B2230"/>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
<Border Style="{StaticResource PopupCard}" Width="460" Padding="8" Margin="14,6,14,20">
        <StackPanel>
          <Border Background="{DynamicResource Field}" CornerRadius="12" Padding="12,0" Height="40" Margin="0,0,0,6">
            <DockPanel>
              <local:Glyph DockPanel.Dock="Left" Data="{StaticResource IcTabSearch}" Size="16" Foreground="{DynamicResource Muted}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Grid VerticalAlignment="Center">
                <TextBox x:Name="TabSearchBox" BorderThickness="0" Background="Transparent" FontSize="14" Padding="0"
                         TextChanged="TabSearchBox_TextChanged" PreviewKeyDown="TabSearchBox_PreviewKeyDown"/>
                <TextBlock x:Name="TabSearchHint" Text="Найти вкладку по названию или адресу" FontSize="14" Foreground="{DynamicResource Faint}"
                           IsHitTestVisible="False" Margin="2,0,0,0"/>
              </Grid>
            </DockPanel>
          </Border>
          <TextBlock x:Name="TabSearchEmpty" Text="Ничего не найдено" Foreground="{DynamicResource Muted}" Margin="12,10" Visibility="Collapsed"/>
          <ListBox x:Name="TabSearchList" BorderThickness="0" Background="Transparent" MaxHeight="420" Focusable="False"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="TabSearchList_Click">
            <ListBox.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
            </ListBox.Resources>
            <ListBox.ItemContainerStyle>
              <Style TargetType="ListBoxItem">
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                      <Border x:Name="Bd" CornerRadius="10" Padding="10,7" Background="Transparent">
                        <ContentPresenter/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Field}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentSoft}"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
              <DataTemplate>
                <DockPanel>
                  <Border DockPanel.Dock="Right" CornerRadius="8" Background="{DynamicResource Field}" Padding="7,2" Margin="8,0,0,0"
                          VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="7" Height="7" Fill="{Binding ContainerBrush}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding Place}" FontSize="11.5" Foreground="{DynamicResource Ink2}"/>
                    </StackPanel>
                  </Border>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Host}" FontSize="12" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DockPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </StackPanel>
      </Border>
</Window>
