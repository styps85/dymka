<Window x:Class="Dymka.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dymka"
        Title="Дымка" Width="1280" Height="820" MinWidth="640" MinHeight="420"
        Background="White" FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal"
        WindowStartupLocation="CenterScreen">

  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="46" ResizeBorderThickness="6"
                  GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="BoolVis"/>

    <!-- Вкладка в полосе сверху -->
    <DataTemplate x:Key="TopTabTemplate" DataType="{x:Type local:BrowserTab}">
      <Border x:Name="Root" Height="32" Margin="0,0,3,4" CornerRadius="10" Background="Transparent"
              Padding="10,0,5,0" VerticalAlignment="Bottom" WindowChrome.IsHitTestVisibleInChrome="True"
              MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp" Tag="{Binding}"
              ToolTip="{Binding Title}" TextElement.Foreground="{StaticResource Ink2}">
        <DockPanel LastChildFill="True">
          <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}"
                  Click="TabClose_Click" Tag="{Binding}" Visibility="Hidden" ToolTip="Закрыть вкладку (Ctrl+W)">
            <local:Glyph Data="{StaticResource IcClose}" Size="13" StrokeWidth="2.4"/>
          </Button>
          <Grid DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
            <Image x:Name="Fav" Source="{Binding Favicon}" Width="16" Height="16" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="Letter" CornerRadius="8" Background="{Binding InitialBg}">
              <TextBlock Text="{Binding Initial}" Foreground="{Binding InitialFg}" FontSize="9.5" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <local:Glyph x:Name="StartGl" Data="{StaticResource IcSearch}" Size="15" Visibility="Collapsed"
                         Foreground="{StaticResource Muted}"/>
            <local:Glyph x:Name="MoonGl" Data="{StaticResource IcMoon}" Size="15" Visibility="Collapsed"
                         Foreground="{StaticResource Muted}"/>
          </Grid>
          <TextBlock x:Name="TitleTb" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     FontWeight="Medium"/>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasFavicon}" Value="True">
          <Setter TargetName="Fav" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsStart}" Value="True">
          <Setter TargetName="StartGl" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Fav" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSleeping}" Value="True">
          <Setter TargetName="MoonGl" Property="Visibility" Value="Visible"/>
          <Setter TargetName="StartGl" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Fav" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Root" Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
        </DataTrigger>
        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
          <Setter TargetName="Root" Property="Background" Value="#E2E7EE"/>
          <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Root" Property="Background" Value="White"/>
          <Setter TargetName="Root" Property="CornerRadius" Value="12,12,0,0"/>
          <Setter TargetName="Root" Property="Height" Value="38"/>
          <Setter TargetName="Root" Property="Margin" Value="0,0,3,0"/>
          <Setter TargetName="Root" Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
          <Setter TargetName="TitleTb" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Вкладка в боковой панели -->
    <DataTemplate x:Key="SideTabTemplate" DataType="{x:Type local:BrowserTab}">
      <Border x:Name="Root" Height="38" Margin="0,1" CornerRadius="10" Background="Transparent" BorderThickness="1"
              BorderBrush="Transparent" Padding="10,0,6,0" MouseLeftButtonDown="Tab_MouseDown" MouseUp="Tab_MouseUp"
              Tag="{Binding}" ToolTip="{Binding Url}" TextElement.Foreground="{StaticResource Ink2}"
              WindowChrome.IsHitTestVisibleInChrome="True">
        <DockPanel LastChildFill="True">
          <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource SmallIconButton}"
                  Click="TabClose_Click" Tag="{Binding}" Visibility="Hidden" ToolTip="Закрыть вкладку (Ctrl+W)">
            <local:Glyph Data="{StaticResource IcClose}" Size="13" StrokeWidth="2.4"/>
          </Button>
          <Grid DockPanel.Dock="Left" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
            <Image x:Name="Fav" Source="{Binding Favicon}" Width="16" Height="16" Visibility="Collapsed"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <Border x:Name="Letter" CornerRadius="9" Background="{Binding InitialBg}" BorderThickness="1"
                    BorderBrush="Transparent">
              <TextBlock x:Name="LetterTb" Text="{Binding Initial}" Foreground="{Binding InitialFg}" FontSize="10" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <local:Glyph x:Name="StartGl" Data="{StaticResource IcSearch}" Size="16" Visibility="Collapsed"
                         Foreground="{StaticResource Muted}"/>
          </Grid>
          <TextBlock x:Name="TitleTb" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                     FontWeight="Medium"/>
        </DockPanel>
      </Border>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding HasFavicon}" Value="True">
          <Setter TargetName="Fav" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsStart}" Value="True">
          <Setter TargetName="StartGl" Property="Visibility" Value="Visible"/>
          <Setter TargetName="Letter" Property="Visibility" Value="Collapsed"/>
          <Setter TargetName="Fav" Property="Visibility" Value="Collapsed"/>
        </DataTrigger>
        <DataTrigger Binding="{Binding IsSleeping}" Value="True">
          <Setter TargetName="Root" Property="Height" Value="34"/>
          <Setter TargetName="Root" Property="TextElement.Foreground" Value="{StaticResource Muted}"/>
          <Setter TargetName="Letter" Property="Background" Value="Transparent"/>
          <Setter TargetName="Letter" Property="BorderBrush" Value="#C3CAD5"/>
          <Setter TargetName="LetterTb" Property="Foreground" Value="{StaticResource Muted}"/>
          <Setter TargetName="Fav" Property="Opacity" Value="0.55"/>
        </DataTrigger>
        <Trigger SourceName="Root" Property="IsMouseOver" Value="True">
          <Setter TargetName="Root" Property="Background" Value="#E3E8EF"/>
          <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
        </Trigger>
        <DataTrigger Binding="{Binding IsActive}" Value="True">
          <Setter TargetName="Root" Property="Background" Value="White"/>
          <Setter TargetName="Root" Property="BorderBrush" Value="#E1E6ED"/>
          <Setter TargetName="Root" Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
          <Setter TargetName="TitleTb" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="CloseBtn" Property="Visibility" Value="Visible"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Кнопка контейнера в боковой панели -->
    <DataTemplate x:Key="ContainerSegTemplate" DataType="{x:Type local:ContainerVM}">
      <Button Click="Container_Click" Tag="{Binding Id}" Style="{StaticResource PlainButton}" Height="30"
              WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{Binding Tip}">
        <Border x:Name="Bd" CornerRadius="9" Background="Transparent">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" Fill="{Binding Brush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="Tb" Text="{Binding Name}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource Ink2}"/>
          </StackPanel>
        </Border>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Bd" Property="Background" Value="White"/>
          <Setter TargetName="Tb" Property="FontWeight" Value="SemiBold"/>
          <Setter TargetName="Tb" Property="Foreground" Value="{StaticResource Ink}"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Строка контейнера во всплывающем меню -->
    <DataTemplate x:Key="ContainerRowTemplate" DataType="{x:Type local:ContainerVM}">
      <Button Click="Container_Click" Tag="{Binding Id}" Style="{StaticResource MenuRow}">
        <DockPanel>
          <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Foreground="{StaticResource Muted}" FontSize="12"
                     VerticalAlignment="Center"/>
          <Ellipse Width="9" Height="9" Fill="{Binding Brush}" Margin="2,0,10,0" VerticalAlignment="Center"/>
          <TextBlock x:Name="Tb" Text="{Binding Name}" VerticalAlignment="Center"/>
        </DockPanel>
      </Button>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
          <Setter TargetName="Tb" Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <Style x:Key="PopupCard" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="#E3E7EE"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Margin" Value="14,6,14,20"/>
      <Setter Property="Effect">
        <Setter.Value>
          <DropShadowEffect BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.14" Color="#1B2230"/>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border x:Name="RootBorder" Background="White">
    <Grid x:Name="RootGrid">
      <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="SideCol" Width="0"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition x:Name="TopRow" Height="46"/>
        <RowDefinition x:Name="ToolRow" Height="56"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- ===== Полоса вкладок сверху ===== -->
      <Grid x:Name="TopStrip" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Background="{StaticResource Strip}">
        <DockPanel Margin="12,0,150,0" LastChildFill="False">
          <ContentControl DockPanel.Dock="Left" Content=" " ContentTemplate="{StaticResource AppMark}" Width="22" Height="22"
                          Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False"/>
          <ItemsControl x:Name="TopTabs" DockPanel.Dock="Left" ItemTemplate="{StaticResource TopTabTemplate}"
                        VerticalAlignment="Bottom" Focusable="False" ClipToBounds="True">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <local:ShrinkTabPanel Reserve="44"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Width="32" Height="32" Margin="2,0,0,4"
                  VerticalAlignment="Bottom" Click="NewTab_Click" ToolTip="Новая вкладка (Ctrl+T)">
            <local:Glyph Data="{StaticResource IcPlus}" Size="18"/>
          </Button>
        </DockPanel>
      </Grid>

      <!-- ===== Боковая панель ===== -->
      <Border x:Name="Sidebar" Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" Background="{StaticResource Strip}"
              Visibility="Collapsed">
        <DockPanel Margin="12,10,12,12">
          <StackPanel DockPanel.Dock="Top">
            <StackPanel Orientation="Horizontal" Height="34" Margin="6,0,0,0">
              <ContentControl Content=" " ContentTemplate="{StaticResource AppMark}" Width="22" Height="22" VerticalAlignment="Center"
                              Focusable="False"/>
              <TextBlock Text="Дымка" FontSize="15" FontWeight="Bold" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Background="#E3E8EF" CornerRadius="12" Padding="4" Margin="0,8,0,0">
              <ItemsControl x:Name="ContainerSeg" ItemTemplate="{StaticResource ContainerSegTemplate}" Focusable="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </Border>
            <Button Style="{StaticResource MenuRow}" Margin="0,8,0,0" Click="NewTab_Click" ToolTip="Ctrl+T">
              <StackPanel Orientation="Horizontal">
                <local:Glyph Data="{StaticResource IcPlus}" Size="17" Foreground="{StaticResource Ink2}" Margin="0,0,10,0"/>
                <TextBlock Text="Новая вкладка" FontWeight="SemiBold" Foreground="{StaticResource Ink2}"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Bottom">
            <Border Background="White" CornerRadius="12" Padding="14,11" Margin="0,10,0,6" ToolTip="Сколько оперативной памяти сейчас занимает браузер со всеми вкладками">
              <StackPanel>
                <DockPanel>
                  <TextBlock DockPanel.Dock="Right" x:Name="SideMemText" Text="…" FontWeight="Bold" FontSize="12"/>
                  <TextBlock Text="Память браузера" FontSize="12" Foreground="{StaticResource Ink2}"/>
                </DockPanel>
                <Border Height="6" CornerRadius="3" Background="{StaticResource Line}" Margin="0,8,0,0" ClipToBounds="True">
                  <Border x:Name="SideMemBar" Height="6" CornerRadius="3" Background="{StaticResource Accent}"
                          HorizontalAlignment="Left" Width="0"/>
                </Border>
              </StackPanel>
            </Border>
            <Button Style="{StaticResource MenuRow}" Click="Settings_Click">
              <StackPanel Orientation="Horizontal">
                <local:Glyph Data="{StaticResource IcSettings}" Size="17" Foreground="{StaticResource Ink2}" Margin="0,0,10,0"/>
                <TextBlock Text="Настройки" Foreground="{StaticResource Ink2}"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
            <ScrollViewer.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
            </ScrollViewer.Resources>
            <StackPanel>
              <TextBlock Text="ОТКРЫТЫ" Style="{StaticResource SectionLabel}"/>
              <ItemsControl x:Name="SideAwake" ItemTemplate="{StaticResource SideTabTemplate}" Focusable="False"/>
              <StackPanel x:Name="SleepHeader" Orientation="Horizontal" Margin="10,14,10,4" Visibility="Collapsed">
                <local:Glyph Data="{StaticResource IcMoon}" Size="12" Foreground="{StaticResource Muted}" Margin="0,0,6,0"
                             VerticalAlignment="Center"/>
                <TextBlock Text="СПЯТ" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Muted}"/>
              </StackPanel>
              <ItemsControl x:Name="SideSleeping" ItemTemplate="{StaticResource SideTabTemplate}" Focusable="False"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- ===== Панель адреса ===== -->
      <Border x:Name="Toolbar" Grid.Row="1" Grid.Column="1" Background="White" BorderBrush="{StaticResource Line}"
              BorderThickness="0,0,0,1">
        <DockPanel x:Name="ToolbarDock" Margin="12,0,10,0">
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="BackBtn" Style="{StaticResource IconButton}" Click="Back_Click" ToolTip="Назад (Alt+←)">
              <local:Glyph Data="{StaticResource IcBack}"/>
            </Button>
            <Button x:Name="ForwardBtn" Style="{StaticResource IconButton}" Click="Forward_Click" ToolTip="Вперёд (Alt+→)" Margin="2,0">
              <local:Glyph Data="{StaticResource IcForward}"/>
            </Button>
            <Button x:Name="ReloadBtn" Style="{StaticResource IconButton}" Click="Reload_Click" ToolTip="Обновить (F5)">
              <local:Glyph x:Name="ReloadGlyph" Data="{StaticResource IcReload}" Size="17"/>
            </Button>
          </StackPanel>

          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource IconButton}" Click="Print_Click" ToolTip="Печать (Ctrl+P)" Margin="0,0,2,0">
              <local:Glyph Data="{StaticResource IcPrint}" Size="18"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Downloads_Click" ToolTip="Загрузки (Ctrl+J)">
              <local:Glyph Data="{StaticResource IcDownload}"/>
            </Button>
            <Button x:Name="MenuBtn" Style="{StaticResource IconButton}" Click="Menu_Click" ToolTip="Меню" Margin="2,0,0,0">
              <Grid>
                <local:Glyph Data="{StaticResource IcDots}" Filled="True"/>
                <Ellipse x:Name="UpdateDot" Width="8" Height="8" Fill="{StaticResource Accent}" Stroke="White" StrokeThickness="1.5"
                         HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-3,-4,0" Visibility="Collapsed"/>
              </Grid>
            </Button>
          </StackPanel>

          <Border x:Name="AddressBorder" Height="38" Margin="10,0,8,0" CornerRadius="19" Background="{StaticResource Field}"
                  BorderThickness="1.5" BorderBrush="Transparent" VerticalAlignment="Center"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <DockPanel Margin="14,0,5,0">
              <local:Glyph x:Name="AddrIcon" DockPanel.Dock="Left" Data="{StaticResource IcSearch}" Size="16"
                           Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
              <Button x:Name="ShieldBtn" DockPanel.Dock="Right" Click="Shield_Click" Focusable="False"
                      ToolTip="Защита на этом сайте" Margin="6,0,0,0" Height="28" Cursor="Hand">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="14" Background="{StaticResource GreenSoft}" Padding="9,0,10,0">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:Glyph x:Name="Gl" Data="{StaticResource IcShield}" Size="15" StrokeWidth="2.3"
                                     Foreground="{StaticResource Green}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="Tb" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   Margin="5,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Green}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#D3EDDF"/>
                      </Trigger>
                      <Trigger Property="IsEnabled" Value="False">
                        <Setter TargetName="Bd" Property="Background" Value="#ECEFF3"/>
                        <Setter TargetName="Gl" Property="Foreground" Value="{StaticResource Muted}"/>
                        <Setter TargetName="Tb" Property="Foreground" Value="{StaticResource Muted}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
              </Button>
              <Button x:Name="ContainerChip" DockPanel.Dock="Right" Click="ContainerChip_Click" Focusable="False"
                      Height="28" ToolTip="Контейнер: сайты в разных контейнерах не видят cookie друг друга">
                <Button.Template>
                  <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="14" Background="White" Padding="10,0">
                      <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Bd" Property="Background" Value="#F8F9FB"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Button.Template>
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="ContainerDot" Width="8" Height="8" Fill="{StaticResource Accent}" Margin="0,0,6,0"
                           VerticalAlignment="Center"/>
                  <TextBlock x:Name="ContainerName" Text="Работа" FontSize="12" FontWeight="SemiBold"
                             Foreground="{StaticResource Ink2}" VerticalAlignment="Center"/>
                </StackPanel>
              </Button>
              <Grid VerticalAlignment="Center">
                <TextBox x:Name="Address" BorderThickness="0" Background="Transparent" FontSize="14"
                         Foreground="{StaticResource Ink}" CaretBrush="{StaticResource Ink}" Padding="0"
                         VerticalContentAlignment="Center" KeyDown="Address_KeyDown"
                         GotKeyboardFocus="Address_GotFocus" LostKeyboardFocus="Address_LostFocus"
                         PreviewMouseLeftButtonDown="Address_PreviewMouseDown" SelectionBrush="{StaticResource Accent}"/>
                <TextBlock x:Name="AddressPlaceholder" Text="Искать или ввести адрес" FontSize="14"
                           Foreground="#7A8394" IsHitTestVisible="False" VerticalAlignment="Center" Margin="2,0,0,0"/>
                <TextBlock x:Name="AddressDisplay" FontSize="14" IsHitTestVisible="False" VerticalAlignment="Center"
                           Margin="2,0,0,0" TextTrimming="CharacterEllipsis" Background="{StaticResource Field}"
                           Visibility="Collapsed">
                  <Run x:Name="AddrHost" Foreground="{StaticResource Ink}" FontWeight="SemiBold"/><Run x:Name="AddrRest" Foreground="{StaticResource Muted}"/>
                </TextBlock>
              </Grid>
            </DockPanel>
          </Border>
        </DockPanel>
      </Border>

      <!-- ===== Содержимое вкладок ===== -->
      <Grid x:Name="ContentHost" Grid.Row="2" Grid.Column="1" Background="{StaticResource Ground}"/>

      <!-- ===== Кнопки окна ===== -->
      <StackPanel x:Name="WindowButtons" Grid.Row="0" Grid.Column="1" Orientation="Horizontal"
                  HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Style="{StaticResource WinButton}" Click="Minimize_Click" ToolTip="Свернуть">
          <local:Glyph Data="{StaticResource IcMin}" Size="15" StrokeWidth="1.7"/>
        </Button>
        <Button Style="{StaticResource WinButton}" Click="Maximize_Click" ToolTip="Развернуть">
          <local:Glyph x:Name="MaxGlyph" Data="{StaticResource IcMax}" Size="14" StrokeWidth="1.8"/>
        </Button>
        <Button Style="{StaticResource WinCloseButton}" Click="Close_Click" ToolTip="Закрыть">
          <local:Glyph Data="{StaticResource IcClose}" Size="15" StrokeWidth="1.7"/>
        </Button>
      </StackPanel>

      <!-- ===== Панель защиты сайта ===== -->
      <Popup x:Name="PrivacyPopup" PlacementTarget="{Binding ElementName=ShieldBtn}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-300" VerticalOffset="4">
        <Border Style="{StaticResource PopupCard}" Width="370" Padding="18">
          <StackPanel>
            <DockPanel>
              <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource GreenSoft}" Margin="0,0,12,0"
                      x:Name="PpLockBg">
                <local:Glyph x:Name="PpLockIcon" Data="{StaticResource IcLock}" Size="17" StrokeWidth="2.3"
                             Foreground="{StaticResource Green}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="PpHost" FontSize="15" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="PpSecure" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource GreenPale}" CornerRadius="14" Padding="16,12" Margin="0,14,0,0">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="PpCount" Text="0" FontSize="30" FontWeight="Bold" Foreground="{StaticResource Green}"/>
                  <TextBlock Text="заблокировано на странице" FontSize="13" Foreground="{StaticResource Ink2}"
                             VerticalAlignment="Bottom" Margin="10,0,0,7"/>
                </StackPanel>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="PpTrackers" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13"/>
                  <TextBlock Text="Трекеры и реклама" FontSize="13" Foreground="{StaticResource Ink2}"/>
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                  <TextBlock x:Name="PpCookies" DockPanel.Dock="Right" FontWeight="Bold" FontSize="13"/>
                  <TextBlock Text="Сторонние cookie" FontSize="13" Foreground="{StaticResource Ink2}"/>
                </DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="ДЛЯ ЭТОГО САЙТА" Style="{StaticResource SectionLabel}" Margin="0,16,0,8"/>

            <DockPanel Margin="0,4">
              <CheckBox x:Name="PpBlockToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                        Click="PpBlockToggle_Click" VerticalAlignment="Center"/>
              <TextBlock Text="Блокировать трекеры" FontSize="13.5" VerticalAlignment="Center"/>
            </DockPanel>
            <DockPanel Margin="0,8,0,4">
              <CheckBox x:Name="PpCookieToggle" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                        Click="PpCookieToggle_Click" VerticalAlignment="Center"/>
              <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Хранить cookie после закрытия" FontSize="13.5"/>
                <TextBlock x:Name="PpCookieHint" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>

            <StackPanel x:Name="PpPermissions" Margin="0,4,0,0"/>

            <Border Height="1" Background="{StaticResource Line}" Margin="0,12"/>
            <DockPanel>
              <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Background="{StaticResource Field}"
                      BorderBrush="{StaticResource Field}" Content="Настройки" Margin="8,0,0,0" Click="Settings_Click"/>
              <Button Style="{StaticResource SecondaryButton}" Content="Очистить данные сайта" Click="ClearSite_Click"/>
            </DockPanel>
          </StackPanel>
        </Border>
      </Popup>

      <!-- ===== Меню ===== -->
      <Popup x:Name="MainMenu" PlacementTarget="{Binding ElementName=MenuBtn}" Placement="Bottom" StaysOpen="False"
             AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-292" VerticalOffset="2">
        <Border Style="{StaticResource PopupCard}" Width="330" Padding="6">
          <StackPanel>
            <Border Background="{StaticResource Field}" CornerRadius="10" Padding="12,9" Margin="0,0,0,6">
              <DockPanel>
                <TextBlock x:Name="MenuMemText" DockPanel.Dock="Right" Text="…" FontWeight="Bold" FontSize="12.5"/>
                <TextBlock Text="Память браузера" FontSize="12.5" Foreground="{StaticResource Ink2}"/>
              </DockPanel>
            </Border>
            <Button Style="{StaticResource MenuRow}" Click="NewTab_Click">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl+T" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <local:Glyph Data="{StaticResource IcPlus}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Новая вкладка" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="ReopenClosed_Click" x:Name="ReopenItem">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl+Shift+T" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <local:Glyph Data="{StaticResource IcUndo}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Вернуть закрытую вкладку" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="SleepOthers_Click">
              <DockPanel>
                <local:Glyph Data="{StaticResource IcMoon}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Усыпить остальные вкладки" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Border Height="1" Background="{StaticResource Line}" Margin="8,5"/>
            <Button Style="{StaticResource MenuRow}" Click="ToggleLayout_Click">
              <DockPanel>
                <local:Glyph x:Name="LayoutGlyph" Data="{StaticResource IcLayoutSide}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock x:Name="LayoutItemText" Text="Вкладки сбоку" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Print_Click">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl+P" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <local:Glyph Data="{StaticResource IcPrint}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Печать" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Downloads_Click">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="Ctrl+J" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <local:Glyph Data="{StaticResource IcDownload}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Загрузки" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="DevTools_Click">
              <DockPanel><TextBlock DockPanel.Dock="Right" Text="F12" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                <local:Glyph Data="{StaticResource IcCode}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Инструменты разработчика" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Border Height="1" Background="{StaticResource Line}" Margin="8,5"/>
            <Button Style="{StaticResource MenuRow}" Click="ClearAllNow_Click">
              <DockPanel>
                <local:Glyph Data="{StaticResource IcTrash}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Удалить cookie и данные сайтов…" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="Settings_Click">
              <DockPanel>
                <local:Glyph Data="{StaticResource IcSettings}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="Настройки" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="UpdateItem_Click">
              <DockPanel>
                <local:Glyph Data="{StaticResource IcDownload}" Size="16" Foreground="{StaticResource Accent}" Margin="0,0,12,0"/>
                <TextBlock x:Name="UpdateItemText" Text="Проверить обновления" VerticalAlignment="Center"/></DockPanel>
            </Button>
            <Button Style="{StaticResource MenuRow}" Click="About_Click">
              <DockPanel>
                <local:Glyph Data="{StaticResource IcInfo}" Size="16" Foreground="{StaticResource Ink2}" Margin="0,0,12,0"/>
                <TextBlock Text="О программе" VerticalAlignment="Center"/></DockPanel>
            </Button>
          </StackPanel>
        </Border>
      </Popup>

      <!-- ===== Выбор контейнера (из адресной строки) ===== -->
      <Popup x:Name="ContainerMenu" PlacementTarget="{Binding ElementName=ContainerChip}" Placement="Bottom"
             StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-120" VerticalOffset="4">
        <Border Style="{StaticResource PopupCard}" Width="250" Padding="6">
          <StackPanel>
            <TextBlock Text="КОНТЕЙНЕР" Style="{StaticResource SectionLabel}" Margin="10,6,10,4"/>
            <ItemsControl x:Name="ContainerList" ItemTemplate="{StaticResource ContainerRowTemplate}" Focusable="False"/>
            <TextBlock Text="Сайты в разных контейнерах не видят cookie и данные друг друга."
                       TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="10,6,10,8"/>
          </StackPanel>
        </Border>
      </Popup>
    </Grid>
  </Border>
</Window>
