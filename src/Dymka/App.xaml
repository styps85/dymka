    <Geometry x:Key="IcClose">M6 6 L18 18 M18 6 L6 18</Geometry>
    <Geometry x:Key="IcPlus">M12 5 L12 19 M5 12 L19 12</Geometry>
    <Geometry x:Key="IcSearch">M18 11 A7 7 0 1 1 4 11 A7 7 0 1 1 18 11 M20 20 L16 16</Geometry>
