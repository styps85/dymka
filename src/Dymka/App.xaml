<Application x:Class="Dymka.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Dymka"
             ShutdownMode="OnLastWindowClose">
  <Application.Resources>

    <!-- Цвета -->
    <Color x:Key="AccentColor">#3D63DD</Color>
    <SolidColorBrush x:Key="Accent" Color="#3D63DD"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#EAF0FF"/>
    <SolidColorBrush x:Key="Ink" Color="#1B2230"/>
    <SolidColorBrush x:Key="Ink2" Color="#3D4656"/>
    <SolidColorBrush x:Key="Muted" Color="#5B6475"/>
    <SolidColorBrush x:Key="Line" Color="#E8ECF2"/>
    <SolidColorBrush x:Key="LineStrong" Color="#D7DDE6"/>
    <SolidColorBrush x:Key="Ground" Color="#F7F9FC"/>
    <SolidColorBrush x:Key="Strip" Color="#EEF1F6"/>
    <SolidColorBrush x:Key="Field" Color="#F1F4F8"/>
    <SolidColorBrush x:Key="Hover" Color="#E6EAF0"/>
    <SolidColorBrush x:Key="Pressed" Color="#DCE1E9"/>
    <SolidColorBrush x:Key="Green" Color="#1C7F53"/>
    <SolidColorBrush x:Key="GreenSoft" Color="#E3F3EA"/>
    <SolidColorBrush x:Key="GreenPale" Color="#F2F9F5"/>
    <SolidColorBrush x:Key="Danger" Color="#C42B1C"/>

    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- Значки (сетка 24x24) -->
    <Geometry x:Key="IcBack">M15 18 L9 12 L15 6</Geometry>
    <Geometry x:Key="IcForward">M9 18 L15 12 L9 6</Geometry>
    <Geometry x:Key="IcReload">M20 11 A8 8 0 1 0 17.7 16.7 M20 4 L20 11 L13 11</Geometry>
