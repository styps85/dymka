<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Dymka</RootNamespace>
    <AssemblyName>Dymka</AssemblyName>
    <ApplicationIcon>Assets\dymka.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Дымка</Product>
    <Company>Дымка</Company>
    <Description>Лёгкий конфиденциальный браузер</Description>
    <Version>1.0.0</Version>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <ServerGarbageCollector>false</ServerGarbageCollector>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Dymka.Core\Dymka.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\dymka.ico" />
    <Resource Include="Assets\dymka-256.png" />
    <EmbeddedResource Include="Web\start.html" LogicalName="Dymka.Web.start.html" />
    <EmbeddedResource Include="Web\translate.js" LogicalName="Dymka.Web.translate.js" />
    <EmbeddedResource Include="Web\forms.js" LogicalName="Dymka.Web.forms.js" />
    <EmbeddedResource Include="Bundled\russian_trusted_root_ca.crt" LogicalName="Dymka.ru-root.crt" />
    <EmbeddedResource Include="Bundled\russian_trusted_sub_ca.crt" LogicalName="Dymka.ru-sub.crt" />
    <EmbeddedResource Include="Bundled\vot-extension.zip" LogicalName="Dymka.vot.zip" Condition="Exists('Bundled\vot-extension.zip')" />
  </ItemGroup>

</Project>
