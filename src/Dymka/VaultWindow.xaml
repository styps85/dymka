<Window x:Class="Dymka.VaultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Dymka"
        Title="Пароли и автозаполнение - Дымка" Width="900" Height="680" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Ground}" FontFamily="{StaticResource UiFont}" FontSize="13.5"
        Foreground="{StaticResource Ink}" UseLayoutRounding="True">
  <Window.Resources>
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="9" Background="Transparent" Padding="16,6">
              <ContentPresenter x:Name="Cp" TextElement.FontSize="13" TextElement.FontWeight="Medium" TextElement.Foreground="{StaticResource Ink2}"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="White"/>
                <Setter TargetName="Cp" Property="TextElement.FontWeight" Value="SemiBold"/>
                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{StaticResource Ink}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Bd" CornerRadius="16" BorderThickness="1.5" BorderBrush="{StaticResource LineStrong}" Background="White" Padding="14,6">
              <ContentPresenter TextElement.FontSize="13"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="ListItem" TargetType="ListBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Bd" CornerRadius="10" Padding="12,8" Margin="0,1" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Field}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20,16,20,20">
    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
      <Border DockPanel.Dock="Right" Background="#E3E8EF" CornerRadius="12" Padding="4" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <RadioButton x:Name="TabPasswords" Style="{StaticResource Tab}" GroupName="vt" Content="Пароли" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabCards" Style="{StaticResource Tab}" GroupName="vt" Content="Карточки" Checked="Tab_Checked"/>
          <RadioButton x:Name="TabSecurity" Style="{StaticResource Tab}" GroupName="vt" Content="Защита" Checked="Tab_Checked"/>
        </StackPanel>
      </Border>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <local:Glyph Data="{StaticResource IcKey}" Size="22" Foreground="{StaticResource Accent}" Margin="0,0,10,0"/>
        <TextBlock Text="Пароли и автозаполнение" FontSize="19" FontWeight="Bold"/>
      </StackPanel>
    </DockPanel>

    <Grid>
      <!-- ===== Пароли ===== -->
      <Grid x:Name="PagePasswords">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="310"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="10">
          <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
              <TextBox x:Name="PwSearch" Style="{StaticResource FieldBox}" TextChanged="PwSearch_TextChanged"/>
              <TextBlock x:Name="PwSearchHint" Text="Поиск по сайту и логину" Foreground="#7A8394" IsHitTestVisible="False"
                         VerticalAlignment="Center" Margin="13,0,0,0"/>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Добавить пароль" Style="{StaticResource SecondaryButton}" Click="PwNew_Click" Margin="0,0,0,6"/>
              <Button Content="Импорт из Chrome или Яндекса (CSV)…" Style="{StaticResource SecondaryButton}" Click="PwImport_Click"/>
            </StackPanel>
            <TextBlock x:Name="PwEmpty" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="6,4"
                       Text="Сохранённых паролей нет. После входа на сайт «Дымка» предложит сохранить пароль, а пароли из другого браузера можно перенести через файл CSV."/>
            <ListBox x:Name="PwList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ListItem}"
                     SelectionChanged="PwList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
              </ListBox.Resources>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Host}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Username}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
          <Grid>
            <TextBlock x:Name="PwNone" Text="Выберите пароль слева" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <StackPanel x:Name="PwEditor" Visibility="Collapsed">
              <TextBlock Text="Сайт" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
              <TextBox x:Name="PwUrl" Style="{StaticResource FieldBox}"/>
              <TextBlock Text="Логин" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Скопировать" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PwCopyUser_Click"/>
                <TextBox x:Name="PwUser" Style="{StaticResource FieldBox}"/>
              </DockPanel>
              <TextBlock Text="Пароль" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
              <DockPanel>
                <Button DockPanel.Dock="Right" Content="Скопировать" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PwCopyPass_Click"/>
                <Button x:Name="PwShowBtn" DockPanel.Dock="Right" Content="Показать" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PwShow_Click"/>
                <Grid>
                  <PasswordBox x:Name="PwPass" FontSize="14" Height="38" Padding="10,0" VerticalContentAlignment="Center"
                               Background="{StaticResource Field}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1.5"/>
                  <TextBox x:Name="PwPassPlain" Style="{StaticResource FieldBox}" Visibility="Collapsed"/>
                </Grid>
              </DockPanel>
              <TextBlock Text="Примечание" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,12,0,4"/>
              <TextBox x:Name="PwNote" Style="{StaticResource FieldBox}"/>
              <TextBlock x:Name="PwInfo" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
              <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="PwSave_Click"/>
                <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="PwDelete_Click"/>
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== Карточки ===== -->
      <Grid x:Name="PageCards" Visibility="Collapsed">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="260"/>
          <ColumnDefinition Width="14"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="10">
          <DockPanel>
            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
              <Button Content="Добавить карточку" Style="{StaticResource SecondaryButton}" Click="CardNew_Click"/>
            </StackPanel>
            <TextBlock x:Name="CardEmpty" DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource Muted}" Margin="6,4"
                       Text="Карточек пока нет. Добавьте свою («Я»), карточку арбитражного управляющего и карточки должников - тогда в анкетах на сайтах появится подсказка «Заполнить»."/>
            <ListBox x:Name="CardList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ListItem}"
                     SelectionChanged="CardList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding ShortName}" FontSize="12" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </DockPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="4">
          <Grid>
            <TextBlock x:Name="CardNone" Text="Выберите или добавьте карточку" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <DockPanel x:Name="CardEditorHost" Visibility="Collapsed">
              <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="18,12">
                <StackPanel Orientation="Horizontal">
                  <Button Content="Сохранить карточку" Style="{StaticResource PrimaryButton}" MinWidth="150" Click="CardSave_Click"/>
                  <Button Content="Удалить" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="CardDelete_Click"/>
                </StackPanel>
              </Border>
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,14,18,8">
                <ScrollViewer.Resources>
                  <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinScroll}"/>
                </ScrollViewer.Resources>
                <StackPanel x:Name="CardEditor"/>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </Border>
      </Grid>

      <!-- ===== Защита ===== -->
      <ScrollViewer x:Name="PageSecurity" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" HorizontalAlignment="Left">
          <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Как хранятся пароли" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Ink2}" LineHeight="20"
                         Text="Пароли и карточки хранятся только на этом компьютере в зашифрованном файле (AES-256). Ключ защищён вашей учётной записью Windows: на другом компьютере или под другим пользователем файл не открыть. Никуда в интернет они не отправляются. Подставляются данные только когда вы выбрали их в подсказке."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,0,0,14">
            <StackPanel>
              <TextBlock Text="Главный пароль" FontSize="15" FontWeight="Bold" Margin="0,0,0,8"/>
              <TextBlock x:Name="MasterInfo" TextWrapping="Wrap" Foreground="{StaticResource Ink2}" LineHeight="20"/>
              <WrapPanel Margin="0,12,0,0">
                <Button x:Name="MasterSetBtn" Content="Задать главный пароль" Style="{StaticResource PrimaryButton}" Margin="0,0,8,8" Click="MasterSet_Click"/>
                <Button x:Name="MasterRemoveBtn" Content="Убрать главный пароль" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="MasterRemove_Click"/>
                <Button x:Name="LockNowBtn" Content="Закрыть хранилище сейчас" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8" Click="LockNow_Click"/>
              </WrapPanel>
              <TextBlock x:Name="LockLabel" Text="Закрывать хранилище после простоя:" Margin="0,8,0,8"/>
              <WrapPanel x:Name="LockPanel"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource Card}" Padding="22,18">
            <StackPanel>
              <TextBlock Text="Подсказки" FontSize="15" FontWeight="Bold" Margin="0,0,0,10"/>
              <DockPanel Margin="0,0,0,12">
                <CheckBox x:Name="OfferSaveBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Offer_Click"/>
                <TextBlock Text="Предлагать сохранить пароль после входа на сайт" VerticalAlignment="Center"/>
              </DockPanel>
              <DockPanel>
                <CheckBox x:Name="OfferFillBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" VerticalAlignment="Center" Click="Offer_Click"/>
                <StackPanel Margin="0,0,16,0">
                  <TextBlock Text="Предлагать заполнить анкету данными карточки"/>
                  <TextBlock Text="Подсказка появляется, когда вы встаёте в поле вроде «Фамилия», «ИНН», «Серия паспорта», «Адрес»." FontSize="12"
                             Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,0"/>
                </StackPanel>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
